# ==============================================================================
# DocMind Nexus — Root .gitignore
# ==============================================================================

# ------------------------------------------------------------------------------
# Operating System & IDE Files
# ------------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

.vscode/
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~

# ------------------------------------------------------------------------------
# Environment Variables & Secrets
# ------------------------------------------------------------------------------
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.pem
*.key
*.cert

# ------------------------------------------------------------------------------
# Python & Backend Artifacts
# ------------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Python Virtual Environments
.venv/
venv/
ENV/
env/
env.bak/
venv.bak/
.venv*/

# Testing, Coverage & Type Checking
.pytest_cache/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
.mypy_cache/
.pyre/
.pytype/
cython_debug/

# ------------------------------------------------------------------------------
# Databases, ChromaDB & Dynamic Storage
# ------------------------------------------------------------------------------
*.db
*.db-journal
*.sqlite
*.sqlite3
docmind.db
chroma_db/
.chroma/
backend/chroma_db/

# Keep sample documents in backend/storage/ but ignore dynamically uploaded files
backend/storage/uploads/
backend/storage/tmp/
backend/storage/*.tmp

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ------------------------------------------------------------------------------
# Node.js & Frontend Artifacts
# ------------------------------------------------------------------------------
node_modules/
frontend/node_modules/
frontend/dist/
frontend/dist-ssr/
frontend/.vite/

# Editor directories and temporary local build outputs
.eslintcache
.stylelintcache
*.tsbuildinfo
