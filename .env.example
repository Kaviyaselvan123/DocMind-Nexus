# DocMind AI Environment Configuration

# Database: Defaults to SQLite (zero friction local setup). For PostgreSQL, set:
# DATABASE_URL=postgresql://user:password@localhost:5432/docmind
DATABASE_URL=sqlite:///./docmind.db

# JWT Security
JWT_SECRET=docmind-super-secret-key-change-in-production-123456789
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Anthropic Claude API (Optional for LLM Agent)
# If provided, the WebSocket agent orchestrates live Claude 3.5 Sonnet against MCP tools.
# If omitted, DocMind automatically uses its built-in intelligent MCP agent fallback.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-3-5-sonnet-20241022

# Server Configuration
PORT=8000
HOST=0.0.0.0
